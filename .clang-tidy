---
Checks: >
  bugprone-*,
  -bugprone-easily-swappable-parameters,  
  
  clang-analyzer-*,
  
  concurrency-*,
  
  cppcoreguidelines-*,
  -cppcoreguidelines-pro-type-vararg,
  -cppcoreguidelines-avoid-do-while,
  -cppcoreguidelines-macro-usage,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-avoid-c-arrays,
  -cppcoreguidelines-c-copy-assignment-signature,
  -cppcoreguidelines-explicit-virtual-functions,
  -cppcoreguidelines-macro-to-enum,
  -cppcoreguidelines-narrowing-conversions,
  -cppcoreguidelines-noexcept-destructor,
  -cppcoreguidelines-noexcept-move-operations,
  -cppcoreguidelines-noexcept-swap,
  -cppcoreguidelines-non-private-member-variables-in-classes,
  -cppcoreguidelines-use-default-member-init,
  
  misc-*,
  -misc-header-include-cycle,
  -misc-const-correctness,
  
  modernize-*,
  -modernize-use-trailing-return-type,
  -modernize-macro-to-enum,
  
  performance-*,
  
  portability-*,
  -portability-avoid-pragma-once,
  
  readability-*,
  -readability-magic-numbers,
  -readability-uppercase-literal-suffix,
  
  cert-*,
  -cert-arr39-c,
  -cert-con36-c,
  -cert-con54-cpp,
  -cert-ctr56-cpp,
  -cert-dcl03-c,
  -cert-dcl16-c,
  -cert-dcl37-c,
  -cert-dcl50-cpp,
  -cert-dcl51-cpp,
  -cert-dcl54-cpp,
  -cert-dcl58-cpp,
  -cert-dcl59-cpp,
  -cert-env33-c,
  -cert-err09-cpp,
  -cert-err33-c,
  -cert-err34-c,
  -cert-err52-cpp,
  -cert-err58-cpp,
  -cert-err60-cpp,
  -cert-err61-cpp,
  -cert-exp42-c,
  -cert-fio38-c,
  -cert-flp30-c,
  -cert-flp37-c,
  -cert-int09-c,
  -cert-mem57-cpp,
  -cert-msc24-c,
  -cert-msc30-c,
  -cert-msc32-c,
  -cert-msc33-c,
  -cert-msc50-cpp,
  -cert-msc51-cpp,
  -cert-msc54-cpp,
  -cert-oop11-cpp,
  -cert-oop54-cpp,
  -cert-oop57-cpp,
  -cert-oop58-cpp,
  -cert-pos44-c,
  -cert-pos47-c,
  -cert-sig30-c,
  -cert-str34-c,
  
  
  -*-redundant-parentheses,
  
  -hicpp-no-assembler,
WarningsAsErrors: ''
HeaderFilterRegex: '.*/azoth/lib/(include|src)/.*'
ExcludeHeaderFilterRegex: '.*/_deps/.*'
FormatStyle: none
SystemHeaders: false
CheckOptions:
  # Darwin private headers (and platform.hpp, whose macros read as unused off that OS) that include-cleaner would otherwise write into or strip from cross-platform files.
  misc-include-cleaner.IgnoreHeaders: '.*/sys/_types/.*;.*/sys/_pthread/.*;.*/sys/fcntl\.h;.*/sys/signal\.h;.*/sys/unistd\.h;.*/sys/syslimits\.h;.*/malloc/_malloc\.h;.*/mach/(arm|arm64|i386|machine)/.*;.*/_time\.h;.*/_stdlib\.h;.*/azoth/base/config/platform\.hpp'
  bugprone-reserved-identifier.AllowedIdentifiers: '^__has_cpp_attribute$'
  # Empty initializer fix-its remove required argument separators.
  readability-trailing-comma.SingleLineCommaPolicy: 'Ignore'
  readability-identifier-length.MinimumVariableNameLength: '2'
  readability-identifier-length.MinimumParameterNameLength: '2'
  readability-identifier-length.MinimumLoopCounterNameLength: '1'
  readability-identifier-length.IgnoredVariableNames: '^[a-km-z]$'
  readability-identifier-length.IgnoredParameterNames: '^([a-km-z]|to)$'
  readability-identifier-length.IgnoredLoopCounterNames: '^[a-km-z_]$'
  # Plain all-public aggregates (POD bundles, internal detail structs) are intentional here; adding
  # accessor scaffolding to them would be noise. Classes with mixed visibility are still flagged.
  misc-non-private-member-variables-in-classes.IgnoreClassesWithAllMemberVariablesBeingPublic: 'true'
  # File-local subsystem singletons, log-category objects, and test fixtures are intentional
  # internal-linkage globals. The check keeps flagging cross-TU (external-linkage) global state.
  cppcoreguidelines-avoid-non-const-global-variables.AllowInternalLinkage: 'true'
  # The log and assert macros expand to a do/if enabled-gate that inflates cognitive complexity
  # without reflecting author-written control flow. Measure the code as written, not macro internals.
  readability-function-cognitive-complexity.IgnoreMacros: 'true'
  # The real hazard is bitwise ops on signed variables (sign bit is UB/impl-defined). Positive
  # integer literals (mask constants, shift counts) are not that hazard, so do not flag them.
  bugprone-signed-bitwise.IgnorePositiveIntegerLiterals: 'true'
  # flat_hash_map::operator[] inserts like std::map, and bit_vector::operator[] throws out_of_range in every build.
  cppcoreguidelines-pro-bounds-avoid-unchecked-container-access.ExcludeClasses: '::std::map;::std::unordered_map;::std::flat_map;::azo::FlatHashMap;::azo::BitVector'
  # azo::at in core/bounds.hpp traps an out-of-range index in every build.
  cppcoreguidelines-pro-bounds-avoid-unchecked-container-access.FixMode: 'function'
  cppcoreguidelines-pro-bounds-avoid-unchecked-container-access.FixFunction: 'azo::at'
  # Naming, see docs/style-conventions.md. The ignore patterns accept compliant names whose acronyms CamelCase would split (eRGBA8Unorm, g_GPUTime).
  readability-identifier-naming.NamespaceCase: lower_case
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.StructCase: CamelCase
  readability-identifier-naming.UnionCase: CamelCase
  readability-identifier-naming.EnumCase: CamelCase
  readability-identifier-naming.ConceptCase: CamelCase
  readability-identifier-naming.EnumConstantCase: CamelCase
  readability-identifier-naming.EnumConstantPrefix: e
  readability-identifier-naming.EnumConstantIgnoredRegexp: '^e[A-Z][A-Za-z0-9]*$'
  readability-identifier-naming.FunctionCase: lower_case
  readability-identifier-naming.PublicMethodCase: lower_case
  readability-identifier-naming.ProtectedMethodCase: lower_case
  readability-identifier-naming.PrivateMethodCase: CamelCase
  readability-identifier-naming.ParameterCase: camelBack
  readability-identifier-naming.LocalVariableCase: camelBack
  readability-identifier-naming.LocalConstantCase: camelBack
  readability-identifier-naming.PrivateMemberCase: camelBack
  readability-identifier-naming.PrivateMemberPrefix: m_
  readability-identifier-naming.PrivateMemberIgnoredRegexp: '^m_[a-z][A-Za-z0-9]*$'
  readability-identifier-naming.ProtectedMemberCase: camelBack
  readability-identifier-naming.ProtectedMemberPrefix: m_
  readability-identifier-naming.ProtectedMemberIgnoredRegexp: '^m_[a-z][A-Za-z0-9]*$'
  # thread_local has no kind of its own, so t_ names are accepted wherever a global or static is. CVars take their console group (r_bloom for r.Bloom).
  readability-identifier-naming.GlobalVariableCase: CamelCase
  readability-identifier-naming.GlobalVariablePrefix: g_
  readability-identifier-naming.GlobalVariableIgnoredRegexp: '^([gt]_[A-Z][A-Za-z0-9]*|r_[a-z][A-Za-z0-9]*)$'
  readability-identifier-naming.StaticVariableCase: CamelCase
  readability-identifier-naming.StaticVariablePrefix: s_
  readability-identifier-naming.StaticVariableIgnoredRegexp: '^[st]_[A-Z][A-Za-z0-9]*$'
  readability-identifier-naming.ClassMemberCase: CamelCase
  readability-identifier-naming.ClassMemberPrefix: s_
  readability-identifier-naming.ClassMemberIgnoredRegexp: '^[st]_[A-Z][A-Za-z0-9]*$'
  # Trait value variable templates are PascalCase then _v (VariantSize_v) instead of k.
  readability-identifier-naming.ConstexprVariableCase: CamelCase
  readability-identifier-naming.ConstexprVariablePrefix: k
  readability-identifier-naming.ConstexprVariableIgnoredRegexp: '^[A-Z][A-Za-z0-9]*_v$'
  readability-identifier-naming.GlobalConstantCase: CamelCase
  readability-identifier-naming.GlobalConstantPrefix: k
  readability-identifier-naming.GlobalConstantIgnoredRegexp: '^[A-Z][A-Za-z0-9]*_v$'
  readability-identifier-naming.ClassConstantCase: CamelCase
  readability-identifier-naming.ClassConstantPrefix: k
  readability-identifier-naming.MacroDefinitionCase: UPPER_CASE
