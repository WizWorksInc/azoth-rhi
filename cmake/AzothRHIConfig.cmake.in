@PACKAGE_INIT@

# Which backends this build compiled in. For a consumer deciding what to link or fetch beside it,
# since code asks rhi::AvailableBackends at runtime without testing a macro.
set(AzothRHI_BACKEND_VULKAN @AZOTH_RHI_BACKEND_VULKAN@)
set(AzothRHI_BACKEND_D3D12 @AZOTH_RHI_BACKEND_D3D12@)
set(AzothRHI_BACKEND_METAL @AZOTH_RHI_BACKEND_METAL@)

set(AzothRHI_ENABLE_PROFILING @AZOTH_RHI_ENABLE_PROFILING@)

# Whether the PIX sink is in the build. An ON build links the target below, which is yours to define
# before importing us.
set(AzothRHI_PIX @AZOTH_RHI_PIX@)
set(AzothRHI_PIX_TARGET @AZOTH_RHI_PIX_TARGET@)

# Tracy has no option of ours. True means the build found a Tracy client and linked it, which is
# also the target the import below needs to resolve here.
set(AzothRHI_TRACY_ENABLED @AZOTH_RHI_TRACY_ENABLED@)
set(AzothRHI_TRACY_TARGET @AZOTH_RHI_TRACY_TARGET@)

include("${CMAKE_CURRENT_LIST_DIR}/AzothRHITargets.cmake")

# Link azoth::rhi-native-vulkan to include azoth/rhi/native/vulkan_native.hpp. Plain azoth::rhi
# does not put the Vulkan headers on your include path.

check_required_components(AzothRHI)
